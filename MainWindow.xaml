<Window x:Class="AlbTasks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AlbTasks.Views"
        Title="AlbTasks" 
        Icon="icon.ico" 
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Margens levemente aumentadas para dar um respiro elegante, sem sobrar espaço vazio -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LADO ESQUERDO: APP PRINCIPAL -->
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/>    
                <RowDefinition Height="Auto"/> 
            </Grid.RowDefinitions>

            <!-- Topo: Demandas e Botões com margem confortável -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" ItemsSource="{Binding DemandasAtivas}" SelectedItem="{Binding DemandaSelecionada}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,5,0">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,5,5"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Background" Value="#E0E0E0"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2E8B57"/><Setter Property="Foreground" Value="White"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding NomeDemanda}" FontWeight="SemiBold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="⏰" FontSize="14" Width="30" Height="30" Margin="0,0,5,0" Command="{Binding AbrirFormDiariaCommand}" Cursor="Hand" ToolTip="Cadastrar Atividade Diária"/>
                    <Button Content="📝" FontSize="14" Width="30" Height="30" Margin="0,0,5,0" Command="{Binding AbrirFormPipelineCommand}" Cursor="Hand" ToolTip="Gerenciar Pipelines"/>
                    <Button Content=" + " FontSize="16" FontWeight="Bold" Width="30" Height="30" Command="{Binding AbrirFormCommand}" Cursor="Hand" ToolTip="Adicionar Demanda"/>
                </StackPanel>
            </Grid>

            <!-- Centro: Texto com mais espaço vertical proporcional -->
            <TextBlock Grid.Row="1" Text="{Binding TextoPassoAtual}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="0,18,0,18"/>

            <!-- Botões de Ação -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding VoltarPassoCommand}" Content="⏪ Voltar" FontSize="14" FontWeight="Bold" Background="#696969" Foreground="White" Margin="0,0,6,0" Padding="10" Cursor="Hand" BorderThickness="0" ToolTip="Voltar para a etapa anterior"/>
                <Button Grid.Column="1" Command="{Binding AvancarPassoCommand}" Content="FEITO (Enter)" FontSize="16" FontWeight="Bold" Background="#2E8B57" Foreground="White" Padding="10" Cursor="Hand" BorderThickness="0" IsDefault="True"/>
            </Grid>
        </Grid>

        <!-- LADO DIREITO: GAVETA DE ALERTAS -->
        <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="10,0,0,0"
                Visibility="{Binding IsListaLembretesVisivel, Converter={StaticResource BoolToVis}}">
            
            <ScrollViewer VerticalAlignment="Center" MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LembretesAtivos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Adicionamos um MouseLeftButtonUp para permitir clicar na caixinha e editar a diária -->
                            <Border Margin="0,0,0,5" CornerRadius="4" Padding="6,6,8,6" Cursor="Hand"
                                    MouseLeftButtonUp="Border_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2E8B57" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NivelUrgencia}" Value="1">
                                                <DataTrigger.EnterActions><BeginStoryboard Name="AnimacaoAlerta"><Storyboard RepeatBehavior="Forever"><ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" From="#DAA520" To="#FF8C00" Duration="0:0:1.5" AutoReverse="True"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="AnimacaoAlerta"/></DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NivelUrgencia}" Value="2">
                                                <DataTrigger.EnterActions><BeginStoryboard Name="AnimacaoUrgente"><Storyboard RepeatBehavior="Forever"><ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" From="#FF8C00" To="#DC143C" Duration="0:0:0.4" AutoReverse="True"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="AnimacaoUrgente"/></DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Texto}" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="Feito!" FontSize="10" Command="{Binding DataContext.ConcluirDiariaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding AtividadeOriginal}" Background="White" Foreground="Black" FontWeight="Bold" Padding="6,2" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- FORMULÁRIOS MODULARIZADOS -->
        <views:FormNovaDemanda Visibility="{Binding IsFormularioVisivel, Converter={StaticResource BoolToVis}}" Grid.ColumnSpan="2"/>
        <views:FormPipeline Visibility="{Binding IsFormularioPipelineVisivel, Converter={StaticResource BoolToVis}}" Grid.ColumnSpan="2"/>
        <views:FormDiaria Visibility="{Binding IsFormularioDiariaVisivel, Converter={StaticResource BoolToVis}}" Grid.ColumnSpan="2"/>
        
    </Grid>
</Window>