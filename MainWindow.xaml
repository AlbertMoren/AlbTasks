<Window x:Class="AlbTasks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlbTasks"
        mc:Ignorable="d"
        Title="AlbTasks" Width="350" MinHeight="220" SizeToContent="Height"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- TELA 1: FOCO PRINCIPAL -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Topo -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0" ItemsSource="{Binding DemandasAtivas}" 
                         SelectedItem="{Binding DemandaSelecionada}" 
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,0,5,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,5,5"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Background" Value="#E0E0E0"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2E8B57"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NomeDemanda}" FontWeight="SemiBold" 
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Grupo de Botões (Nova Pipeline e Nova Demanda) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="📝" FontSize="14" Width="30" Height="30" Margin="0,0,5,0" 
                            Command="{Binding AbrirFormPipelineCommand}" Cursor="Hand" ToolTip="Criar Nova Pipeline"/>
                    <Button Content=" + " FontSize="16" FontWeight="Bold" Width="30" Height="30" 
                            Command="{Binding AbrirFormCommand}" Cursor="Hand" ToolTip="Adicionar Demanda"/>
                </StackPanel>
            </Grid>

            <!-- Centro e Rodapé -->
            <TextBlock Grid.Row="1" Text="{Binding TextoPassoAtual}" FontSize="18" FontWeight="Bold" 
                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="0,25"/>
            <Button Grid.Row="2" Command="{Binding AvancarPassoCommand}" Content="FEITO (Enter)" 
                    FontSize="16" FontWeight="Bold" Background="#2E8B57" Foreground="White" 
                    Padding="10" Cursor="Hand" BorderThickness="0" IsDefault="True"/>
        </Grid>

        <!-- TELA 2: FORMULÁRIO DE NOVA DEMANDA -->
        <Grid Background="White" Margin="15" 
              Visibility="{Binding IsFormularioVisivel, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Nova Demanda" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="1" Text="{Binding NovaDemandaNome, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="5" Margin="0,0,0,10"/>
            <!-- ComboBox com Placeholder Simulado -->
            <Grid Grid.Row="2" Margin="0,0,0,10" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding TiposDePipeline}" 
                          SelectedItem="{Binding NovaDemandaPipeline}" 
                          FontSize="14" Padding="5" />
                
                <!-- O texto cinza que some quando algo é selecionado -->
                <TextBlock Text="Selecione uma opção..." Foreground="Gray" FontSize="14" 
                           Margin="8,7,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <!-- Mostra o texto se a variável estiver nula ou vazia -->
                                <DataTrigger Binding="{Binding NovaDemandaPipeline}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NovaDemandaPipeline}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar" Command="{Binding CancelarFormCommand}" Margin="0,0,5,0" Padding="8" Background="#DC143C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Grid.Column="1" Content="Salvar" Command="{Binding SalvarNovaDemandaCommand}" Margin="5,0,0,0" Padding="8" Background="#2E8B57" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Grid>

        <!-- TELA 3: GERENCIAR PIPELINE -->
        <Grid Background="White" Margin="15" 
              Visibility="{Binding IsFormularioPipelineVisivel, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Título -->
                <RowDefinition Height="Auto"/> <!-- Dropdown para selecionar Ação/Edição -->
                <RowDefinition Height="Auto"/> <!-- Label Nome -->
                <RowDefinition Height="Auto"/> <!-- Input Nome -->
                <RowDefinition Height="Auto"/> <!-- Label Passos -->
                <RowDefinition Height="*"/>    <!-- Input Passos -->
                <RowDefinition Height="Auto"/> <!-- Botões -->
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Gerenciar Pipelines" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            
            <!-- Seletor: Criar Nova ou Editar Existente -->
            <ComboBox Grid.Row="1" ItemsSource="{Binding OpcoesEdicaoPipeline}" 
                      SelectedItem="{Binding OpcaoEdicaoSelecionada}" 
                      FontSize="14" Padding="5" Margin="0,0,0,15" Background="#F0F0F0" FontWeight="SemiBold"/>
            
            <TextBlock Grid.Row="2" Text="Nome da Pipeline:" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
            <TextBox Grid.Row="3" Text="{Binding NovoPipelineNome, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="14" Padding="5" Margin="0,0,0,10"/>
            
            <TextBlock Grid.Row="4" Text="Etapas (use ponto e vírgula ';' para separar):" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
            <TextBox Grid.Row="5" Text="{Binding NovoPipelinePassos, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="14" Padding="5" Margin="0,0,0,15" MinHeight="80" 
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Botão Excluir (Só aparece na edição) -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="🗑️" Command="{Binding ExcluirPipelineCommand}" 
                        Visibility="{Binding IsModoEdicao, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,10,0" Padding="8,8" Width="40" Background="#DC143C" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Excluir Pipeline"/>
                
                <Button Grid.Column="1" Content="Cancelar" Command="{Binding CancelarFormPipelineCommand}" Margin="0,0,5,0" Padding="8" Background="Gray" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Grid.Column="2" Content="Salvar" Command="{Binding SalvarNovoPipelineCommand}" Margin="5,0,0,0" Padding="8" Background="#2E8B57" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Grid>
</Window>